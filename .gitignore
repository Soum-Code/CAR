# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Experiment outputs — never commit, they are regenerated from configs + seeds
# Note: runs/* not runs/ -- git cannot re-include a file inside an excluded
# directory, and the GPU measurement below has to be kept.
runs/*
# ...except the GPU measurements, which cost Kaggle sessions to produce and
# cannot be regenerated on CPU.
!runs/semantic_scope_prm.json
!runs/semantic_scope_judge_independent.json
!runs/semantic_scope_judge_same_model.json
outputs/
*.jsonl
!tests/fixtures/*.jsonl

# Model + data caches
.cache/
data/raw/
data/processed/
*.safetensors
*.bin

# Notebooks
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Kaggle upload staging: a duplicate of src/ + scripts/, rebuilt on demand
.kaggle_stage/
