# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Experiment outputs — never commit, they are regenerated from configs + seeds
# Note: runs/* not runs/ -- git cannot re-include a file inside an excluded
# directory, and the GPU measurement below has to be kept.
runs/*
# ...except the GPU measurements, which cost Kaggle sessions to produce and
# cannot be regenerated on CPU.
!runs/semantic_scope_prm.json
!runs/semantic_scope_judge_independent.json
!runs/semantic_scope_judge_same_model.json
# 7h40m of Kaggle T4x2. Same rationale: cannot be regenerated on CPU.
!runs/generated_qwen25_7b.jsonl
!runs/generated_qwen25_7b_meta.json
!runs/uncertainty_qwen25_7b.jsonl
# ~4h of T4x2 resampling. semantic_samples.jsonl is the raw K=5 continuations,
# kept so a future equivalence relation can be tried without a GPU at all.
!runs/uncertainty_qwen25_7b_sem.jsonl
!runs/uncertainty_qwen25_7b_exactmatch.jsonl
!runs/semantic_samples.jsonl
!runs/probe_qwen25_7b.json
outputs/
# Thesis figures are build products, but they are the paper's figures --
# committed so the draft renders on GitHub without a build step.
!docs/thesis/figures/*
*.jsonl
!tests/fixtures/*.jsonl
# Repeated below the blanket *.jsonl rule on purpose: git applies the LAST
# matching pattern, so a negation placed only above it has no effect.
!runs/generated_qwen25_7b.jsonl
!runs/uncertainty_qwen25_7b.jsonl
!runs/uncertainty_qwen25_7b_sem.jsonl
!runs/uncertainty_qwen25_7b_exactmatch.jsonl
!runs/semantic_samples.jsonl

# Model + data caches
.cache/
data/raw/
data/processed/
*.safetensors
*.bin

# Notebooks
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Kaggle upload staging: a duplicate of src/ + scripts/, rebuilt on demand
.kaggle_stage/
